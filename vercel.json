{
  "buildCommand": "npm install && npm run build && mkdir -p ../api && cp api/server.js ../api/server.js",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/server.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server.js"
    }
  ]
}
